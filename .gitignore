# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.pytest_cache/
/artifacts/
**/__pycache__/
*.pyc

# next.js
/.next/
/.vinext/
/out/

